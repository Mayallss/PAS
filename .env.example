# Copy to .env for local development. Never commit real secrets; production values come from AWS Secrets Manager (infra/).
DATABASE_URL=postgresql://pas:pas_dev_only@localhost:5432/pas
TEST_DATABASE_URL=postgresql://pas:pas_dev_only@localhost:5432/pas_test

API_PORT=4000
# Public origin of the web app (the API is reached through the Next.js /api proxy on the same origin).
APP_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=10
TZ_BUSINESS=Asia/Bangkok

# OIDC (Google Workspace / Microsoft Entra ID / any OIDC IdP) — pending docs/06 Q7
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Development-only e-mail login for seeded test users. Refused when NODE_ENV=production.
AUTH_DEV_LOGIN=true

# รับ–ส่งเอกสาร (monday board). Token: monday → Developers → My access tokens (needs read items, upload files, change columns).
MONDAY_API_TOKEN=
MONDAY_HANDOFF_BOARD_ID=1862570548
# Text columns for the signer's name and the save time. Ids differ per board: monday → column menu → "Copy column ID".
MONDAY_HANDOFF_SIGNER_COLUMN=text_mm7xtpds
MONDAY_HANDOFF_SIGNED_AT_COLUMN=text_mm7x9rpf
# Random 64 hex chars: openssl rand -hex 32
HANDOFF_LINK_SECRET=

# Google Calendar mirror for room bookings and approved leave (docs/09 §4). Empty = not connected (changes queue up).
# Service account with domain-wide delegation, scope https://www.googleapis.com/auth/calendar. Key on one line with 
.
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_COMPANY_CALENDAR_ID=
GOOGLE_REMINDER_MINUTES=1440,30
CALENDAR_SYNC_INTERVAL_MS=60000

# Username + password sign-in (docs/09 §7). On unless set to false — keep it on until Google SSO is live.
PASSWORD_LOGIN=true

# Evidence files: empty = local folder (STORAGE_DIR, default var/uploads). On AWS the ECS task sets the S3 bucket.
S3_BUCKET=

# TRCLOUD (accounting): contacts → customer code / tax id / address, sales invoices → revenue.
# All values from TRCLOUD → RESTFUL API → Setting → API Key. Keep PASSKEY and ENCRYPT_HEAD secret
# (the key has the company's full rights in TRCLOUD); this system only ever calls search/read.
TRCLOUD_BASE_URL=
TRCLOUD_COMPANY_ID=
TRCLOUD_PASSKEY=
TRCLOUD_ENCRYPT_HEAD=
TRCLOUD_ORIGIN=
