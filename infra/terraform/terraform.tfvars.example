# Copy to terraform.tfvars and edit. terraform.tfvars is git-ignored.

alert_email        = "it@pas-acc.com"
monthly_budget_usd = 40

# --- Step 1 (testing): leave the domain empty -> portal on http://<alb-dns-name> ---
domain_name = ""

# --- Step 2 (real use): set a host name you control, then add the DNS records from the outputs ---
# domain_name          = "portal.pas-acc.com"
# oidc_allowed_domain  = "pas-acc.com"
# enable_cognito_login = true

# Public website (apps/site) — off by default to save credits
# enable_site      = true
# site_domain_name = "pas-acc.com"

# Credit savers
use_fargate_spot  = true
app_desired_count = 1

# CI/CD: GitHub Actions deploys on push to main (see infra/DEPLOY-AWS.md §8)
github_repo = "Mayallss/PAS"

# n8n — https://n8n.pas-acc.com (see n8n.tf). Add the DNS records from: terraform output n8n_acm_validation_records
# enable_n8n      = true
# n8n_domain_name = "n8n.pas-acc.com"
# n8n_editor_allowed_cidrs = ["x.x.x.x/32"]   # limit the editor to the office IP; webhooks stay public
