# Copy to .env for local development. Never commit real secrets; production values come from Secret Manager.
DATABASE_URL=postgresql://pas:pas_dev_only@localhost:5432/pas
TEST_DATABASE_URL=postgresql://pas:pas_dev_only@localhost:5432/pas_test

API_PORT=4000
# Public origin of the web app (the API is reached through the Next.js /api proxy on the same origin).
APP_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=10
TZ_BUSINESS=Asia/Bangkok

# OIDC (Google Workspace / Microsoft Entra ID / any OIDC IdP) — pending docs/06 Q7
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Development-only e-mail login for seeded test users. Refused when NODE_ENV=production.
AUTH_DEV_LOGIN=true
